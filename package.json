{
  "name": "tunnel",
  "version": "0.1.0",
  "private": true,
  "description": "Tunnel - 本地多协议文件传输器（Electron + Vue 3）",
  "main": "dist/main/main/electron.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.node.json --noEmit",
    "build:main": "tsc -p tsconfig.node.json",
    "build:web": "vite build",
    "build": "npm run build:main && npm run build:web",
    "dev:core": "tsx src/main/cli.ts",
    "dev:web": "vite",
    "dev:electron": "npm run build && node scripts/ensure-electron.mjs && node scripts/launch-electron.mjs .",
    "test:e2e": "tsx scripts/e2e.ts",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "basic-ftp": "^5.0.5",
    "ssh2": "^1.16.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ssh2": "^1.15.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "ftp-srv": "^4.6.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vue": "^3.5.13"
  },
  "build": {
    "appId": "com.tunnel.desktop",
    "productName": "Tunnel",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/",
        "to": "native",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
